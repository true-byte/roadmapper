{
  "name": "roadmapper",
  "version": "1.0.0",
  "description": "Roadmapper draws a roadmap, kept in one JSON file, as a tree: zoomed out, anyone can read it, and zooming in shows more detail.",
  "license": "MIT",
  "keywords": [
    "roadmap",
    "tree",
    "plan",
    "svg"
  ],
  "homepage": "https://github.com/true-byte/roadmapper#readme",
  "bugs": "https://github.com/true-byte/roadmapper/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/true-byte/roadmapper.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/types/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    },
    "./react": {
      "types": "./dist/lib/types/lib/react.d.ts",
      "default": "./dist/lib/react.js"
    },
    "./roadmapper.js": "./dist/lib/roadmapper.js"
  },
  "bin": {
    "roadmapper": "dist/cli/roadmapper.js"
  },
  "files": [
    "dist/lib",
    "dist/cli",
    "data/sample.roadmap.json",
    "docs"
  ],
  "sideEffects": [
    "./dist/lib/index.js",
    "./dist/lib/roadmapper.js"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/roadmapper.mjs build",
    "preview": "vite preview --outDir ../../dist/app",
    "check": "tsc --noEmit",
    "validate": "node scripts/roadmapper.mjs validate",
    "build:tests": "node scripts/build.mjs tests",
    "test": "node scripts/build.mjs lib cli tests && playwright test",
    "test:push": "node scripts/build.mjs lib cli tests && node scripts/test-push.mjs",
    "build:lib": "node scripts/build.mjs lib",
    "build:cli": "node scripts/build.mjs cli",
    "package": "node scripts/build.mjs lib cli && node scripts/pack.mjs",
    "prepack": "node scripts/build.mjs lib cli",
    "export": "node scripts/build.mjs lib && node scripts/roadmapper.mjs export",
    "export:preview": "node scripts/roadmapper.mjs export:preview"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iconify-json/tabler": "1.2.42",
    "@playwright/test": "1.63.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "playwright": "1.63.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
